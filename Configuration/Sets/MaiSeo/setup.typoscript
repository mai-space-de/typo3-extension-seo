# Literal additionalWhere: do not rely on {$seo.sitemap.pages.additionalWhere}.
# Site-settings→TypoScript constant injection breaks when any setting value
# contains raw newlines or `{…}` blocks (see search.rag.userTemplate / BGM-41).
plugin.tx_seo {
    config {
        xmlSitemap {
            sitemaps {
                pages {
                    config {
                        additionalWhere = {#no_index} = 0 AND {#canonical_link} = ''
                    }
                }
            }
        }
    }
}

# Record sitemaps (news/jobs/…) intentionally omitted: News/Jobs are page
# doktypes (covered by pages sitemap). Re-add RecordsXmlSitemapDataProvider
# entries only when seo.sitemap.records.*.detailPid > 0.
