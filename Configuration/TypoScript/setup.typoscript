plugin.tx_maispace_seo {
    jsonLd {
        enable = 1
        defaultType = WebPage
        organizationName =
        organizationUrl =
        organizationLogo =
    }
    openGraph {
        enable = 1
        siteName =
        defaultImage =
        twitter = 1
        twitterSite =
    }
    canonical {
        enable = 1
    }
    robots {
        enable = 1
    }
    metaDescription {
        enable = 1
    }
    aiRobots {
        enable = 1
        bots = GPTBot, OAI-SearchBot, ClaudeBot, Google-Extended, PerplexityBot, CCBot, Bytespider, Amazonbot
    }
    llmsTxt {
        enable = 1
        url = /llms.txt
    }
}
