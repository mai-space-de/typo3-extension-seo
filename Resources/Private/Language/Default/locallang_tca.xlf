                <source>Open Graph &amp; Schema</source>
            </trans-unit>

            <trans-unit id="pages.tx_maiseo_og_title">
                <source>Open Graph Title</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_og_title.description">
                <source>Overrides the page title used in og:title meta tag. Leave empty to use the page title.</source>
            </trans-unit>

            <trans-unit id="pages.tx_maiseo_og_description">
                <source>Open Graph Description</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_og_description.description">
