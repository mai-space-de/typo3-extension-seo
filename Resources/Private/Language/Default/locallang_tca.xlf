            <trans-unit id="pages.tx_maiseo_og_image">
                <source>Open Graph Image</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_og_image.description">
                <source>Image used for og:image. Recommended size: 1200×630 px.</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_og_image.addFile">
                <source>Add image</source>
            </trans-unit>

            <trans-unit id="pages.tx_maiseo_schema_type">
                <source>Schema.org Type</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_schema_type.description">
                <source>Overrides the root @type for this page's JSON-LD structured data.</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_schema_type.auto">
                <source>Auto (detect from page type)</source>
            </trans-unit>

            <trans-unit id="pages.tx_maiseo_structured_data">
                <source>Structured Data (JSON-LD)</source>
            </trans-unit>
            <trans-unit id="pages.tx_maiseo_structured_data.description">
                <source>Visual editor for schema.org JSON-LD structured data. Auto-generated values are shown with a lock icon and can be overridden.</source>
            </trans-unit>
